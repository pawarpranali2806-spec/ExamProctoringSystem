# Panopticon Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=panopticon-super-secret-key-change-in-production-2026

# Database
# For SQLite: sqlite:///panopticon.db
# For PostgreSQL: postgresql://username:password@localhost:5432/panopticon_db
DATABASE_URL=sqlite:///panopticon.db

# AI Proctoring Thresholds
HEAD_POSE_YAW_THRESHOLD=28.0
HEAD_POSE_PITCH_THRESHOLD=22.0
EYE_GAZE_EAR_THRESHOLD=0.18
EYE_GAZE_LOOKAWAY_FRAMES=6
MOBILE_DETECTION_CONFIDENCE=0.45
PERSON_DETECTION_CONFIDENCE=0.50

# Cheating Risk Engine
RISK_DECAY_RATE=0.92
RISK_WARNING_THRESHOLD=45
RISK_HIGH_THRESHOLD=70
RISK_CRITICAL_THRESHOLD=88
